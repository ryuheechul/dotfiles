# -*- mode: sh; -*- vim: set ft=zsh:

# other terminals who can fix this issue directly are done there:
# - ../../wezterm
# - ../../ghostty
# - ../../alacritty
# - ../../nix/home/terminals
# - ../../bin/terminal/ghostty

# but for those which can not fix themselves have a chance to set it here
if printenv __CFBundleIdentifier | grep dev.warp >/dev/null; then
  export UNSET_HOST_ALWAYS_USE_TMUX=1
elif test "${CMUX_BUNDLE_ID}" = "com.cmuxterm.app"; then
  export UNSET_HOST_ALWAYS_USE_TMUX=1
elif test "${TERM_PROGRAM}" = "iTerm.app"; then
  export UNSET_HOST_ALWAYS_USE_TMUX=1
fi

if test -n "${HERDR_ENV}"; then
  unset HOST_ALWAYS_USE_TMUX
  unset ALL_MY_ZSH_STUFF_LOADED
fi

# this is technically not a terminal but to handle devenv shell (or via a hook)
if test -n "${DEVENV_PROFILE}"; then
  export UNSET_ALL_MY_ZSH_STUFF_LOADED=1
fi

# Apple container machine run starts the session with TERM=xterm and never forwards
# the host TERM (otherwise you would pass -e TERM=... on every call), so
# terminfo reports 8 colours even though COLORTERM=truecolor comes from
# home-manager session vars. is-container-machine detects the session via
# /etc/.machine.initialized (set by the runtime on both 1.5 and 1.6) -
# upgrade only while TERM=xterm and not over ssh, so ssh (client-declared TERM)
# and tmux (its own screen/tmux-256color) keep theirs.
if is-container-machine && test "${TERM}" = xterm && test -z "${SSH_CONNECTION}"; then
  export TERM=xterm-256color
fi
