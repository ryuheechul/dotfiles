#!/usr/bin/env bash

# age-ssh-nt runs Passage with identities derived from enrolled SSH-agent keys.
# It owns bootstrap, device enrollment, outer re-encryption, inner identity
# rotation/finalization, status diagnostics, and the decrypted Passage bridge.
#
# Plaintext identities exist only in private temporary storage. Linux unlinks
# the temp file after opening fd 3; macOS/BSD keeps the 0600 name because its
# /dev/fd uses shared offsets. Mutations are serialized and use atomic writes,
# recipient backups, verification, and explicit rollback paths.
#
# PASSAGE_DIR defaults to ~/.passage/store. AGE_SSH_NT_HOME defaults to the
# dfs-rhc XDG data directory with previous-XDG and legacy fallbacks. Run
# `age-ssh-nt help` for commands or `age-ssh-nt doc` for the full design,
# security model, file layout, and recovery procedures.

set -euo pipefail

PASSAGE_DIR="${PASSAGE_DIR:-$HOME/.passage/store}"
if [[ -z "${AGE_SSH_NT_HOME:-}" ]]; then
  data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  default_home="$data_home/dfs-rhc/age-ssh-nt"
  previous_xdg_home="$data_home/age-ssh-nt"
  legacy_home="$HOME/.age/age-ssh-nt"
  if [[ -d "$default_home" ]]; then
    AGE_SSH_NT_HOME="$default_home"
  elif [[ -d "$previous_xdg_home" ]]; then
    AGE_SSH_NT_HOME="$previous_xdg_home"
  elif [[ -d "$legacy_home" ]]; then
    AGE_SSH_NT_HOME="$legacy_home"
  else
    AGE_SSH_NT_HOME="$default_home"
  fi
fi

identities_dir="${AGE_SSH_NT_HOME}"
recipients="${AGE_SSH_NT_HOME}/authorized_recipients"
out="${AGE_SSH_NT_HOME}/identities.age"
out_recipients_hash="${out}.recipients-sha256"
rotation_backup="${out}.rotation.bak"
store_recipients="${PASSAGE_DIR}/.age-recipients"
store_recipients_backup="${store_recipients}.age-ssh-nt.bak"
store_recipients_snapshot="${PASSAGE_DIR}/.age-recipients.age-ssh-nt.rotation.bak"
store_recipients_backup_comment="# age-ssh-nt: generated backup of .age-recipients - do not edit
# overwritten before the next age-ssh-nt recipient-list rewrite
# safe to delete after age-ssh-nt status confirms .age-recipients is valid"

# The documentation, resolved relative to this script's real location (the
# repo layout: bin/path/ssh/age-ssh-nt + bin/docs/age-ssh-nt.md). Physical
# path resolution (cd -P) follows the ~/.config/dfs-rhc -> repo symlink so the
# repo path is found even when invoked through it. Override with AGE_SSH_NT_DOC.
script_dir="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_bin="$(cd -P -- "$script_dir/../.." && pwd)"
doc="${AGE_SSH_NT_DOC:-$repo_bin/docs/age-ssh-nt.md}"

# Platform-aware temp dir: RAM-backed on systemd/Linux, launchd per-user dir on
# macOS, plain /tmp as last resort (see header comment for the tradeoffs).
tmpdir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
mutation_lock="$identities_dir/.mutation.lock"
passage_tmp=""
out_hash_tmp=""
encryption_recipients_tmp=""
held_lock=""
rotation_snapshot_active=0
rotation_snapshot_missing=0
rotation_installed=0
rotation_tmp=""
status_hint_on_error=0

status_hint() {
  echo "hint: run age-ssh-nt status for current state and recovery steps" >&2
}

suppress_status_hint() {
  status_hint_on_error=0
}

fatal() {
  echo "error: $*" >&2
  exit 1
}

fatal_with_hint() {
  echo "error: $1" >&2
  echo "hint: $2" >&2
  exit 1
}

abort_command() {
  suppress_status_hint
  echo "aborted - $*" >&2
  exit 1
}

path_exists() {
  [[ -e "$1" ]] || [[ -L "$1" ]]
}

plain_file() {
  [[ -f "$1" ]] && [[ ! -L "$1" ]]
}

valid_store_recipients_file() {
  local file="$1"
  plain_file "$file" \
    && age -R "$file" -o /dev/null </dev/null >/dev/null 2>&1
}

# Preserve the current recipient list through an atomic sibling rename. An
# invalid current file never replaces a good backup; rotation transactions may
# continue only when such a good backup already exists, so their repair path
# can restore a missing recipient without sacrificing recovery.
backup_store_recipients() {
  local allow_invalid="${1:-0}" dir="" tmp="" current_header=""
  if path_exists "$store_recipients_backup"; then
    plain_file "$store_recipients_backup" || {
      echo "error: store recipient backup is not a regular file: $store_recipients_backup" >&2
      return 1
    }
  fi
  path_exists "$store_recipients" || return 0
  plain_file "$store_recipients" || {
    echo "error: store recipients is not a regular file: $store_recipients" >&2
    return 1
  }
  if ! valid_store_recipients_file "$store_recipients"; then
    if [[ "$allow_invalid" -eq 1 ]] && valid_store_recipients_file "$store_recipients_backup"; then
      echo "warning: current store recipients is invalid; preserving existing backup: $store_recipients_backup" >&2
      return 0
    fi
    echo "error: store recipients is invalid - refusing to overwrite its backup: $store_recipients" >&2
    return 1
  fi
  dir="$(dirname "$store_recipients")"
  tmp="$(mktemp "$dir/.age-recipients.age-ssh-nt.bak.tmp.XXXXXX")" || return 1
  current_header="$(sed -n '1,3p' "$store_recipients")"
  if [[ "$current_header" == "$store_recipients_backup_comment" ]]; then
    cp -p "$store_recipients" "$tmp" || { rm -f "$tmp"; return 1; }
  else
    {
      printf '%s\n\n' "$store_recipients_backup_comment"
      cat "$store_recipients"
    } >"$tmp" || { rm -f "$tmp"; return 1; }
    chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  if ! mv -f "$tmp" "$store_recipients_backup"; then
    rm -f "$tmp"
    return 1
  fi
  valid_store_recipients_file "$store_recipients_backup" || {
    echo "error: store recipient backup could not be verified: $store_recipients_backup" >&2
    return 1
  }
}

restore_store_recipients_snapshot() {
  [[ "$rotation_snapshot_active" -eq 1 ]] || return 0
  if [[ "$rotation_snapshot_missing" -eq 1 ]]; then
    rm -f "$store_recipients" "$store_recipients_snapshot"
  else
    if [[ -d "$store_recipients" ]] && [[ ! -L "$store_recipients" ]]; then
      echo "error: cannot restore recipient snapshot over directory: $store_recipients" >&2
      return 1
    fi
    rm -f "$store_recipients"
    mv -f "$store_recipients_snapshot" "$store_recipients"
  fi
  rotation_snapshot_active=0
}

begin_store_recipients_snapshot() {
  if path_exists "$store_recipients_snapshot"; then
    echo "error: previous rotation recipient snapshot still exists: $store_recipients_snapshot" >&2
    echo "hint: inspect status and restore or remove the snapshot before rotating" >&2
    return 1
  fi
  mkdir -p "$(dirname "$store_recipients")" || return 1
  if path_exists "$store_recipients"; then
    plain_file "$store_recipients" || {
      echo "error: store recipients is not a regular file: $store_recipients" >&2
      return 1
    }
    backup_store_recipients 1 || return 1
    cp -p "$store_recipients" "$store_recipients_snapshot" || return 1
    rotation_snapshot_missing=0
  else
    : >"$store_recipients_snapshot" || return 1
    rotation_snapshot_missing=1
  fi
  rotation_snapshot_active=1
}

commit_store_recipients_snapshot() {
  [[ "$rotation_snapshot_active" -eq 1 ]] || return 0
  rm -f "$store_recipients_snapshot"
  rotation_snapshot_active=0
}

# One cleanup path owns both temporary plaintext and the mutation lock, so
# adding either resource cannot overwrite another EXIT trap.
cleanup() {
  local rc=$?
  [[ -z "$passage_tmp" ]] || rm -f "$passage_tmp"
  [[ -z "$rotation_tmp" ]] || rm -f "$rotation_tmp"
  [[ -z "$out_hash_tmp" ]] || rm -f "$out_hash_tmp"
  [[ -z "$encryption_recipients_tmp" ]] || rm -f "$encryption_recipients_tmp"
  if [[ "$rotation_snapshot_active" -eq 1 ]] && [[ "$rotation_installed" -eq 0 ]]; then
    restore_store_recipients_snapshot || true
  fi
  if [[ -n "$held_lock" ]]; then
    rm -f "$held_lock/pid"
    rmdir "$held_lock" 2>/dev/null || true
  fi
  [[ "$rc" -eq 0 ]] || [[ "$status_hint_on_error" -eq 0 ]] || status_hint
  return "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Serialize state-changing operations with portable atomic mkdir. A SIGKILL
# can leave the directory behind; report its PID and require deliberate manual
# cleanup rather than guessing that a lock is stale and racing a live process.
acquire_mutation_lock() {
  [[ -z "$held_lock" ]] || return 0
  mkdir -p "$identities_dir"
  if ! mkdir "$mutation_lock" 2>/dev/null; then
    local owner=""
    owner="$(cat "$mutation_lock/pid" 2>/dev/null || true)"
    echo "error: another age-ssh-nt mutation is running${owner:+ (pid $owner)}" >&2
    echo "lock: $mutation_lock" >&2
    echo "hint: if that process no longer exists, remove the lock directory manually" >&2
    exit 1
  fi
  held_lock="$mutation_lock"
  printf '%s\n' "$$" >"$held_lock/pid"
}

usage() {
  cat >&2 <<'EOF'
usage: age-ssh-nt bootstrap              bootstrap with an SSH-agent key
       age-ssh-nt enroll                 enroll another agent key
       age-ssh-nt reencrypt              encrypt identities to enrolled keys
       age-ssh-nt rotate                 rotate the Passage identity
       age-ssh-nt rotate finalize        verify and finish a pending rotation
       age-ssh-nt status                 report state and recovery steps
       age-ssh-nt passage <args...>      run Passage with decrypted identities
       age-ssh-nt doc                    open the full documentation
       age-ssh-nt help                   show this help
EOF
}

require_no_args() {
  local command="$1"
  shift
  [[ "$#" -eq 0 ]] || {
    echo "error: $command takes no arguments" >&2
    usage
    exit 1
  }
}

# Slugify an SSH key comment into a safe identity-file name.
slugify() {
  local s="${1:-}"
  s="${s,,}"
  s="${s//[^[:alnum:]]/-}"
  while [[ "$s" == *--* ]]; do s="${s//--/-}"; done
  s="${s#-}"
  s="${s%-}"
  [[ -n "$s" ]] && echo "${s:0:40}"
}

# keygen_identity <name> [selector]: write $AGE_SSH_NT_HOME/<name>.identity
# and print the derived `age1...` public key. Requires the key in the agent.
keygen_identity() {
  local name="${1:-}" selector="${2:-}" identity="$identities_dir/${1:-}.identity"
  mkdir -p "$identities_dir"
  local keygen_dir="" keygen_identity="" out="" pub="" file_pub=""
  local args=()
  if ! keygen_dir="$(mktemp -d "$identities_dir/.keygen.XXXXXX")"; then
    echo "error: could not create a temporary identity directory in $identities_dir" >&2
    return 1
  fi
  keygen_identity="$keygen_dir/$name.identity"
  args=(-o "$keygen_identity")
  [[ -n "$selector" ]] && args+=(-k "$selector")
  # keygen prints the public key to stderr; the identity file itself is
  # non-secret (fingerprint + salt) and safe to keep around
  out="$(age-plugin-sshagent keygen "${args[@]}" 2>&1 >/dev/null || true)"
  pub="$(printf '%s\n' "$out" | sed -n 's/^Public key: //p')"
  file_pub="$(sed -n 's/^# public key: //p' "$keygen_identity" 2>/dev/null | head -1)"
  if [[ -z "$pub" ]] || [[ "$pub" != "$file_pub" ]]; then
    echo "error: keygen failed for '$name' - age-plugin-sshagent said:" >&2
    printf '%s\n' "$out" | sed '/^$/d' | sed 's/^/  /' >&2
    rm -f "$keygen_identity"
    rmdir "$keygen_dir" 2>/dev/null || true
    return 1
  fi
  if [[ -e "$identity" ]] || [[ -L "$identity" ]]; then
    echo "error: identity name became unavailable while waiting: $identity" >&2
    echo "hint: rerun the command to choose a new derived name" >&2
    rm -f "$keygen_identity"
    rmdir "$keygen_dir" 2>/dev/null || true
    return 1
  fi
  if ! mv "$keygen_identity" "$identity"; then
    echo "error: could not install generated identity at $identity" >&2
    rm -f "$keygen_identity"
    rmdir "$keygen_dir" 2>/dev/null || true
    return 1
  fi
  rmdir "$keygen_dir" 2>/dev/null || true
  echo "$pub"
}

# Print the public recipient recorded in an existing plugin identity file.
identity_recipient() {
  sed -n 's/^# public key: //p' "$identities_dir/$1.identity" 2>/dev/null | head -1
}

# Parse one `ssh-add -l` key line (`256 <fp> <comment> (<type>)`) into the
# caller's $fp and $comment (dynamic scoping).
key_line_parts() {
  local line="$1"
  fp="${line#* }"
  fp="${fp%% *}"
  comment="$(printf '%s\n' "$line" | sed 's/^[^ ]* [^ ]* //')"
}

# Choose one key in the SSH agent; sets the caller's name/fp/comment (dynamic
# scoping). One key: used directly. Several: numbered menu, Enter = first,
# EOF aborts.
choose_agent_key() {
  local lines keys chosen n sel line i base num
  # ssh-add -l exits 1 for a missing agent AND for an empty one, so distinguish
  # by message, not by exit code
  lines="$(ssh-add -l 2>&1 || true)"
  [[ "$lines" != *"Could not open a connection"* ]] \
    || fatal "no SSH agent found (SSH_AUTH_SOCK not set?) - connect with: ssh -A"
  [[ "$lines" != *"no identities"* ]] || fatal "SSH agent has no keys - add one with: ssh-add"
  mapfile -t keys < <(printf '%s\n' "$lines" | grep -E 'SHA256:.* \(ED25519\)$' || true)
  [[ ${#keys[@]} -gt 0 ]] || fatal_with_hint \
    "the SSH agent has no supported Ed25519 keys" \
    "age-plugin-sshagent supports ordinary ssh-ed25519 keys (not RSA, ECDSA, or security-key variants)"
  n=${#keys[@]}
  if [[ $n -gt 1 ]]; then
    echo "select the key to use:" >&2
    for i in "${!keys[@]}"; do
      key_line_parts "${keys[$i]}"
      echo "  [$((i + 1))] $comment (${fp:0:12}...)" >&2
    done
    while :; do
      if ! read -r -p "select key [1-$n, Enter = 1]: " sel; then
        abort_command "no key selected"
      fi
      [[ -n "$sel" ]] || sel=1
      if [[ "$sel" =~ ^[0-9]+$ ]] && ((sel >= 1 && sel <= n)); then
        break
      fi
      echo "invalid selection: $sel" >&2
    done
    chosen="${keys[$((sel - 1))]}"
  else
    chosen="${keys[0]}"
  fi
  key_line_parts "$chosen"
  name="$(slugify "$comment")"
  [[ -n "$name" ]] || name="agent-key"
  base="$name"
  num=2
  while [[ -e "$identities_dir/$name.identity" ]]; do
    name="$base-$num"
    num=$((num + 1))
  done
}

# If the key selected in $fp is already enrolled (identity file header records
# it as `# ssh key: <fp> <comment>`), print the identity name and return 0.
# Falls back to the recipient comment lines (append_recipient writes
# `# <name>: <comment> (<fp>)`), so a lost identity file still dedups the key
# and the duplicate-recipient case is reported as already enrolled.
already_enrolled() {
  local f
  for f in "$identities_dir"/*.identity; do
    [[ -f "$f" ]] || continue
    if grep -Fq "$fp" "$f"; then
      basename "$f" .identity
      return 0
    fi
  done
  if [[ -f "$recipients" ]] && grep -Fq "$fp" "$recipients"; then
    # literal match (the fp's base64 can contain / and +, so no regex)
    awk -v fp="$fp" 'index($0, "(" fp ")") { sub(/^# /, ""); sub(/:.*/, ""); print; exit }' "$recipients"
    return 0
  fi
  return 1
}

# Return 0 when the current agent lists a fingerprint recorded by one of the
# enrolled plugin identities. This does not ask the agent to sign.
agent_has_enrolled_key() {
  local agent_fps="" fp="" f
  [[ -n "${SSH_AUTH_SOCK:-}" ]] && [[ -S "$SSH_AUTH_SOCK" ]] || return 1
  agent_fps="$(ssh-add -l 2>/dev/null | awk '{print $2}' || true)"
  [[ -n "$agent_fps" ]] || return 1
  for f in "$identities_dir"/*.identity; do
    [[ -f "$f" ]] || continue
    fp="$(sed -n 's/^# ssh key: \([^ ]*\).*/\1/p' "$f" | head -1)"
    [[ -n "$fp" ]] && grep -qxF "$fp" <<<"$agent_fps" && return 0
  done
  return 1
}

# Rewrite the managed README.md in $AGE_SSH_NT_HOME without embedding the
# checkout's absolute path, so moving the repository cannot stale the pointer.
drop_readme() {
  local readme="$identities_dir/README.md"
  cat >"$readme" <<'EOF'
# age-ssh-nt

This directory is managed by `age-ssh-nt` (SSH-agent-backed passage
identities).

Open the full documentation with: `age-ssh-nt doc`.
Set `AGE_SSH_NT_DOC` to override where that command reads it from.
EOF
}

# Render TSV manifests with rich-table and dependency-free fallbacks.
manifest_table() {
  local w="${COLUMNS:-}"
  [[ -n "$w" ]] && [[ "$w" =~ ^[0-9]+$ ]] || w=200
  if command -v nu >/dev/null 2>&1; then
    nu --stdin --no-config-file -c "from tsv | table --index false -w $w" 1>&2
  elif command -v column >/dev/null 2>&1; then
    column -t -s $'\t' 1>&2
  else
    tr '\t' ' ' 1>&2
  fi
}

agent_trust_warning() {
  echo "warning: enroll only on a trusted host - a host using your forwarded agent can retain the derived age key" >&2
  echo "         agent confirmation approves the signature but cannot prevent the host from keeping its result" >&2
}

# Emit TSV rows (what<TAB>path<TAB>detail) for the enrolled keys, for the
# bootstrap manifest table (label defaults to "use").
enrolled_keys_rows() {
  local f line label="${1:-use}"
  for f in "$identities_dir"/*.identity; do
    [[ -f "$f" ]] || continue
    line="$(sed -n 's/^# ssh key: //p' "$f" | head -1)"
    if [[ -n "$line" ]]; then
      printf '%s\t%s\tkey: %s\n' "$label" "$(basename "$f" .identity)" "$line"
    else
      printf '%s\t%s\t\n' "$label" "$(basename "$f" .identity)"
    fi
  done
}

# Print the canonical effective recipient set: comments and blanks removed,
# keys sorted and deduplicated. The human-edited source file stays untouched.
canonical_recipient_lines() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  awk '!/^[[:space:]]*#/ && NF {print}' "$f" | LC_ALL=C sort -u
}

# Count unique enrolled recipients in the given file (defaults to $recipients).
# A missing file counts as zero so status survives partial state.
recipient_count() {
  local f="${1:-$recipients}"
  canonical_recipient_lines "$f" | awk 'END {print NR+0}'
}

raw_recipient_count() {
  local f="${1:-$recipients}"
  [[ -f "$f" ]] || { echo 0; return 0; }
  awk '!/^[[:space:]]*#/ && NF {n++} END {print n+0}' "$f"
}

# Drop trailing blank lines and leave exactly one separator before an appended
# managed comment/key block. Empty files stay empty rather than gaining a
# leading blank line.
prepare_store_recipient_append() {
  local file="$1" tmp=""
  tmp="${file}.separator"
  if ! awk '
    { lines[NR] = $0 }
    END {
      n = NR
      while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--
      for (i = 1; i <= n; i++) print lines[i]
      if (n > 0) print ""
    }
  ' "$file" >"$tmp" || ! mv -f "$tmp" "$file"; then
    rm -f "$tmp"
    return 1
  fi
}

# Hash the effective recipient set, ignoring comments, blank lines, ordering
# and duplicates. This records the exact set identities.age was encrypted to,
# which its age header intentionally does not reveal.
recipient_set_hash() {
  local f="${1:-$recipients}"
  [[ -f "$f" ]] || return 1
  canonical_recipient_lines "$f" \
    | sha256sum \
    | cut -d' ' -f1
}

prepare_encryption_recipients() {
  encryption_recipients_tmp="$(mktemp "$tmpdir/age-ssh-nt-recipients.XXXXXX")" || return 1
  if ! canonical_recipient_lines "$recipients" >"$encryption_recipients_tmp"; then
    rm -f "$encryption_recipients_tmp"
    encryption_recipients_tmp=""
    return 1
  fi
  [[ -s "$encryption_recipients_tmp" ]] || {
    echo "error: no effective recipients in $recipients" >&2
    rm -f "$encryption_recipients_tmp"
    encryption_recipients_tmp=""
    return 1
  }
}

prepare_out_recipients_hash() {
  if path_exists "$out_recipients_hash"; then
    plain_file "$out_recipients_hash" || {
      echo "error: recipient hash destination is not a regular file: $out_recipients_hash" >&2
      return 1
    }
  fi
  out_hash_tmp="$(mktemp "$identities_dir/.recipients-sha256.XXXXXX")" || return 1
  if ! recipient_set_hash "$recipients" >"$out_hash_tmp"; then
    rm -f "$out_hash_tmp"
    out_hash_tmp=""
    return 1
  fi
  chmod 600 "$out_hash_tmp" || {
    rm -f "$out_hash_tmp"
    out_hash_tmp=""
    return 1
  }
}

commit_out_recipients_hash() {
  [[ -n "$out_hash_tmp" ]] || return 1
  if ! mv -f "$out_hash_tmp" "$out_recipients_hash"; then
    rm -f "$out_hash_tmp"
    out_hash_tmp=""
    return 1
  fi
  out_hash_tmp=""
  plain_file "$out_recipients_hash" || {
    echo "error: recipient hash was not installed as a regular file: $out_recipients_hash" >&2
    return 1
  }
}

rotation_backup_exists() {
  path_exists "$rotation_backup"
}

guard_interrupted_rotation() {
  [[ ! -f "$out" ]] || return 0
  rotation_backup_exists || return 0
  if plain_file "$rotation_backup"; then
    echo "error: rotation was interrupted after preserving the old identities" >&2
    printf 'restore with:\n  mv -- %q %q\n' "$rotation_backup" "$out" >&2
  else
    echo "error: $rotation_backup exists but is not a regular backup file" >&2
    echo "hint: inspect or remove that object before bootstrapping" >&2
  fi
  exit 1
}

# Print: closed-header, recipient-stanza-count, count-is-comparable.
# Plugins may emit multiple custom stanzas per configured recipient, so only
# native X25519 and SSH stanza counts can be compared with recipient lines.
age_header_info() {
  LC_ALL=C awk '
    BEGIN { comparable = 1 }
    function finish_stanza() {
      if (in_stanza && !body_final) malformed = 1
    }
    NR == 1 { if ($0 != "age-encryption.org/v1") malformed = 1; next }
    closed { next }
    /^->/ {
      finish_stanza()
      if ($0 !~ /^-> [!-~]+( [!-~]+)*$/) malformed = 1
      if ($2 == "scrypt") scrypt = 1
      else {
        n++
        if ($2 !~ /^(X25519|ssh-ed25519|ssh-rsa|mlkem768x25519|p256tag)$/) comparable = 0
      }
      in_stanza = 1
      body_final = 0
      next
    }
    /^---/ {
      finish_stanza()
      if ($1 != "---" || NF != 2 || length($2) != 43 || $2 !~ /^[A-Za-z0-9+\/]+$/ || !in_stanza) malformed = 1
      closed = 1
      next
    }
    {
      if (!in_stanza || body_final || length($0) > 64 || $0 !~ /^[A-Za-z0-9+\/]*$/) malformed = 1
      else if (length($0) < 64) body_final = 1
    }
    END {
      valid = closed && !malformed && !scrypt && n > 0
      print valid + 0, n + 0, comparable + 0
    }
  '
}

# Print an armored or binary age header without decrypting its body. Armored
# input is decoded incrementally and stops at the closing header marker; status
# must never decode or inspect ciphertext merely to count recipient stanzas.
age_header() {
  local f="$1" first=""
  [[ -f "$f" ]] || return 1
  read -r first <"$f" || return 1
  # A deliberate 16 MiB decoded-header bound prevents malformed files from
  # making status stream arbitrary ciphertext. Upstream may get SIGPIPE when
  # the footer is found, so extraction remains best-effort by design.
  if [[ "$first" == "-----BEGIN AGE ENCRYPTED FILE-----" ]]; then
    awk 'NR > 1 && !/^-----END AGE ENCRYPTED FILE-----$/ {print} /^-----END AGE ENCRYPTED FILE-----$/ {exit}' "$f" \
      | base64 -d 2>/dev/null \
      | head -c 16777216 \
      | awk '{print} /^--- / {exit}' \
      || true
  else
    head -c 16777216 "$f" \
      | awk '{print} /^--- / {exit}' \
      || true
  fi
  return 0
}

# Populate the caller's failed_files and verified_files for store_files.
verify_store_files() {
  local identity="$1" f
  failed_files=()
  verified_files=0
  for f in "${store_files[@]}"; do
    if age -d -i "$identity" -o /dev/null "$f" 2>/dev/null; then
      verified_files=$((verified_files + 1))
    else
      failed_files+=("$f")
    fi
  done
}

# Append one recipient to $recipients with a comment naming the key it belongs
# to (uses the caller's dynamic $name/$comment/$fp).
append_recipient() {
  local pub="$1"
  printf '# %s: %s (%s)\n%s\n' "$name" "$comment" "$fp" "$pub" >>"$recipients"
}

# Add a step to the status pending list, deduplicated.
pending_add() {
  local p
  for p in "${pending[@]}"; do
    [[ "$p" == "$1" ]] && return 0
  done
  pending+=("$1")
}

# The marker comment section (first line = marker) age-ssh-nt manages in
# $store_recipients: the identities' own public key, so passage can encrypt
# store entries to it. Everything above the marker is the user's own
# recipients and is never touched.
store_recipients_comment="# age-ssh-nt: the passage identities' own age recipient - store entries
# encrypt to this key; age-ssh-nt passage decrypts them on the fly. See
# $AGE_SSH_NT_HOME/ (open the docs with: age-ssh-nt doc)"

# Verify "$1" (an age-encrypted file) decrypts to exactly "$2" with one of the
# enrolled identity files. age aborts on the first plugin identity whose key is
# not in the agent, so each identity must be tried on its own. All in memory
# (process substitution + cmp) - nothing is ever written. Returns 0 when
# verified.
verify_identities() {
  local file="$1" content="$2" f
  for f in "$identities_dir"/*.identity; do
    if [[ -f "$f" ]] && cmp -s <(age -d -i "$f" "$file" 2>/dev/null) <(printf '%s\n' "$content"); then
      return 0
    fi
  done
  return 1
}

# Ensure "$1" (the identities' own public key) is in $store_recipients under
# the marker comment. If "$2" is set, write it immediately before the key.
# Returns nonzero only on error; sets store_recipients_result=added|already.
store_recipients_ensure() {
  local k="$1" note="${2:-}" marker="${store_recipients_comment%%$'\n'*}"
  local dir="" tmp=""
  store_recipients_result="already"
  [[ -n "$k" ]] || {
    echo "error: refusing to add an empty store recipient" >&2
    return 1
  }
  if [[ -f "$store_recipients" ]] && grep -qxF "$k" "$store_recipients"; then
    return 0
  fi
  if path_exists "$store_recipients"; then
    plain_file "$store_recipients" || {
      echo "error: store recipients is not a regular file: $store_recipients" >&2
      return 1
    }
  fi
  if [[ -f "$store_recipients" ]] && [[ "$rotation_snapshot_active" -eq 0 ]]; then
    backup_store_recipients || return 1
  fi
  dir="$(dirname "$store_recipients")"
  mkdir -p "$dir" || return 1
  tmp="$(mktemp "$dir/.age-recipients.tmp.XXXXXX")" || return 1
  if [[ -f "$store_recipients" ]] && ! cat "$store_recipients" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  prepare_store_recipient_append "$tmp" || { rm -f "$tmp"; return 1; }
  if [[ ! -f "$store_recipients" ]] || ! grep -qxF "$marker" "$store_recipients"; then
    printf '%s\n' "$store_recipients_comment" >>"$tmp" || { rm -f "$tmp"; return 1; }
  fi
  if [[ -n "$note" ]] && ! printf '%s\n' "$note" >>"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  printf '%s\n' "$k" >>"$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  if ! mv -f "$tmp" "$store_recipients"; then
    rm -f "$tmp"
    return 1
  fi
  store_recipients_result="added"
}

# Remove one rotation's exact old recipient and notes, then restore the current
# recipient under the canonical managed comment. The caller owns the snapshot.
store_recipients_remove_rotation() {
  local old="$1" current="$2" dir="" tmp=""
  local managed_comment=()
  mapfile -t managed_comment <<<"$store_recipients_comment"
  [[ -n "$old" ]] && [[ -n "$current" ]] || {
    echo "error: refusing to finalize empty store recipients" >&2
    return 1
  }
  plain_file "$store_recipients" || {
    echo "error: store recipients is not a regular file: $store_recipients" >&2
    return 1
  }
  dir="$(dirname "$store_recipients")"
  tmp="$(mktemp "$dir/.age-recipients.tmp.XXXXXX")" || return 1
  if ! awk -v old="$old" -v current="$current" \
    -v c1="${managed_comment[0]}" -v c2="${managed_comment[1]}" -v c3="${managed_comment[2]}" '
    $0 == old || $0 == "# " old { next }
    $0 == current || $0 == c1 || $0 == c2 || $0 == c3 { next }
    $0 == "# age-ssh-nt: rotation pending - backup recipient: " old { pending = 1; next }
    pending && /^# keep it and .* until every store entry works with the new identity$/ { pending = 0; next }
    { pending = 0; print }
  ' "$store_recipients" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  prepare_store_recipient_append "$tmp" || { rm -f "$tmp"; return 1; }
  printf '%s\n%s\n' "$store_recipients_comment" "$current" >>"$tmp" || {
    rm -f "$tmp"
    return 1
  }
  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  if ! mv -f "$tmp" "$store_recipients"; then
    rm -f "$tmp"
    return 1
  fi
}

# Print the enrolled keys (from the identity file headers) for the manifest.
already_bootstrapped() {
  drop_readme
  echo "already bootstrapped: $out" >&2
  echo >&2
  echo "use the store:   age-ssh-nt passage <passage args>" >&2
  echo "                 (e.g. age-ssh-nt passage show <entry>)" >&2
  echo "enroll a device: age-ssh-nt enroll   (from the device via ssh -A; the key is picked from the agent)" >&2
  echo "then:            age-ssh-nt reencrypt" >&2
  echo "rotate identity: age-ssh-nt rotate" >&2
  echo "check status:    age-ssh-nt status   (what's done, what's still pending on both sides)" >&2
}

# Complete metadata that may be missing after an interrupted bootstrap. The
# final identities.age must at least have a valid age header; if its public key
# sidecar is missing, decrypt it in memory with an enrolled agent key and
# derive the store recipient again.
repair_bootstrap_metadata() {
  local header_valid=0 store_pub="" recorded_store_pub="" content="" f repaired=0
  read -r header_valid _ _ < <(age_header "$out" | age_header_info)
  [[ "$header_valid" -eq 1 ]] || fatal_with_hint \
    "$out is incomplete or invalid - bootstrap cannot treat it as complete" \
    "restore a valid backup or move the invalid file aside before running bootstrap again"

  for f in "$identities_dir"/*.identity; do
    [[ -f "$f" ]] || continue
    if content="$(age -d -i "$f" "$out" 2>/dev/null)"; then
      break
    fi
    content=""
  done
  if [[ -z "$content" ]]; then
    if agent_has_enrolled_key; then
      echo "error: an enrolled key is present, but $out failed cryptographic decryption" >&2
      echo "hint: restore a valid identities backup before running bootstrap again" >&2
    else
      echo "error: existing bootstrap could not be cryptographically verified" >&2
      echo "hint: load an enrolled key into the SSH agent, then run bootstrap again" >&2
    fi
    exit 1
  fi
  store_pub="$(printf '%s\n' "$content" | age-keygen -y 2>/dev/null || true)"
  [[ -n "$store_pub" ]] || fatal "could not derive the store recipient while validating bootstrap"
  recorded_store_pub="$(sed -n '/^age1/{p;q;}' "$identities_dir/store_recipient" 2>/dev/null || true)"
  if [[ "$recorded_store_pub" != "$store_pub" ]]; then
    printf '%s\n' "$store_pub" >"$identities_dir/store_recipient"
    repaired=1
  fi
  store_recipients_ensure "$store_pub" || exit 1
  if [[ "$store_recipients_result" == "added" ]]; then
    repaired=1
  fi
  [[ -f "$identities_dir/README.md" ]] || repaired=1
  drop_readme
  [[ "$repaired" -eq 0 ]] || echo "repaired interrupted bootstrap metadata" >&2
}

# Bootstrap with a newly generated identity that is never read from or written
# to a plaintext identity file. Only its verified encrypted form is installed.
cmd_bootstrap() {
  status_hint_on_error=1
  guard_interrupted_rotation
  if [[ -f "$out" ]]; then
    acquire_mutation_lock
    repair_bootstrap_metadata
    already_bootstrapped
    return 0
  fi
  local name="" fp="" comment="" dup=""
  if [[ ! -f "$recipients" ]] || [[ ! -s "$recipients" ]]; then
    choose_agent_key
    dup="$(already_enrolled || true)"
    [[ -z "$dup" ]] || fatal "key $comment ($fp) is already enrolled as $dup - bootstrap wants a fresh key"
  fi

  # generate a fresh identity in memory (never written to disk)
  local content=""
  content="$(age-keygen)"
  local store_pub=""
  store_pub="$(printf '%s\n' "$content" | age-keygen -y 2>/dev/null || true)"

  # manifest: what will happen, before anything is created
  echo
  echo "bootstrapping will:" >&2
  {
    printf 'what\tpath\tdetail\n'
    if [[ -n "$name" ]]; then
      printf 'register\t%s\tkey: %s (%s)\n' "$name" "$comment" "$fp"
      printf 'create\t%s/\tdirectory\n' "$identities_dir"
      printf 'create\t%s/%s.identity\tkey registration (agent-derived, non-secret)\n' "$identities_dir" "$name"
      printf 'create\t%s\trecipient list (1 entry)\n' "$recipients"
    else
      enrolled_keys_rows
      printf 'use\t%s\trecipient list (%s entries)\n' "$recipients" "$(recipient_count)"
    fi
    printf 'create\t%s\tthe passage identities, age-encrypted\n' "$out"
    printf 'create\t%s\texact recipient-set hash for status\n' "$out_recipients_hash"
    printf 'create\t%s\tstore recipient for status checks (the identities'"'"' own public key)\n' "$identities_dir/store_recipient"
    printf 'create\t%s/README.md\tpointer to the documentation (age-ssh-nt doc)\n' "$identities_dir"
    printf 'update\t%s\tadd the identities'"'"' own public key (store encryption)\n' "$store_recipients"
  } | manifest_table
  echo "  (source: fresh identity generated in memory - never saved to disk, nothing to delete)" >&2
  agent_trust_warning

  # confirm before doing anything; a generated identity is non-destructive, so
  # a scripted run (no way to answer) proceeds
  local ans=""
  if ! read -r -p "proceed? [Y/n] " ans; then
    ans="y"
  fi
  case "${ans,,}" in
  "" | y | yes) ;;
  *)
    abort_command "nothing was created"
    ;;
  esac

  acquire_mutation_lock
  guard_interrupted_rotation
  if [[ -f "$out" ]]; then
    repair_bootstrap_metadata
    already_bootstrapped
    return 0
  fi

  # register the first key
  if [[ -n "$name" ]]; then
    local pub
    pub="$(keygen_identity "$name" "$fp")" || exit 1
    mkdir -p "$(dirname "$recipients")"
    append_recipient "$pub"
    echo "registered $name -> $pub" >&2
  fi

  # Install only after verification; reruns repair incomplete metadata.
  prepare_encryption_recipients || exit 1
  printf '%s\n' "$content" | age -a -R "$encryption_recipients_tmp" -o "$out.tmp"
  chmod 600 "$out.tmp"
  if ! verify_identities "$out.tmp" "$content"; then
    echo "error: decryption check failed" >&2
    rm -f "$out.tmp"
    exit 1
  fi
  prepare_out_recipients_hash || {
    rm -f "$out.tmp"
    exit 1
  }
  mv -f "$out.tmp" "$out"
  if ! commit_out_recipients_hash; then
    rm -f "$out"
    echo "error: could not install recipient hash - removed incomplete bootstrap identities" >&2
    exit 1
  fi
  echo "encrypted and verified -> $out ($(recipient_count) recipient(s))" >&2
  drop_readme
  if [[ -n "$store_pub" ]]; then
    store_recipients_ensure "$store_pub" || exit 1
    if [[ "$store_recipients_result" == "added" ]]; then
      echo "store recipients updated: $store_recipients" >&2
    else
      echo "store recipients already up to date: $store_recipients" >&2
    fi
    printf '%s\n' "$store_pub" >"$identities_dir/store_recipient"
  fi
  echo "verified (fresh identity, never saved to disk)" >&2
  echo "verify with: age-ssh-nt passage show <entry>" >&2
}

# Enrollment is strictly additive: register one SSH-agent key and append its
# outer recipient, but never decrypt or rewrite identities.age. Bootstrap
# already performs the first enrollment and must exist first.
cmd_enroll() {
  [[ "$#" -eq 0 ]] || {
    echo "error: enroll takes no arguments - the key is picked from the SSH agent" >&2
    usage
    exit 1
  }
  status_hint_on_error=1
  [[ -f "$out" ]] || {
    echo "error: no bootstrap yet ($out missing) - run: age-ssh-nt bootstrap" >&2
    echo "bootstrap is one-shot: it generates the identity and enrolls the first key" >&2
    exit 1
  }
  local name="" fp="" comment="" dup="" ans="" pub="" repair=0
  choose_agent_key
  dup="$(already_enrolled || true)"
  if [[ -n "$dup" ]]; then
    pub="$(identity_recipient "$dup")"
    if [[ -n "$pub" ]] && ! grep -qxF "$pub" "$recipients" 2>/dev/null; then
      name="$dup"
      repair=1
    else
      fatal "key $comment ($fp) is already enrolled as $dup"
    fi
  fi

  echo >&2
  echo "enrolling will:" >&2
  {
    printf 'what\tpath\tdetail\n'
    if [[ "$repair" -eq 1 ]]; then
      printf 'repair\t%s/%s.identity\tkey exists but its recipient is missing\n' "$identities_dir" "$name"
    else
      printf 'register\t%s\tkey: %s (%s)\n' "$name" "$comment" "$fp"
      printf 'create\t%s/%s.identity\tkey registration (agent-derived, non-secret)\n' "$identities_dir" "$name"
    fi
    printf 'update\t%s\tappend recipient\n' "$recipients"
  } | manifest_table
  agent_trust_warning
  if ! read -r -p "$([[ "$repair" -eq 1 ]] && printf 'repair' || printf 'enroll as') $name? [Y/n] " ans; then
    abort_command "nothing was created"
  fi
  case "${ans,,}" in
  "" | y | yes) ;;
  *)
    abort_command "nothing was created"
    ;;
  esac

  acquire_mutation_lock
  dup="$(already_enrolled || true)"
  if [[ "$repair" -eq 1 ]]; then
    pub="$(identity_recipient "$name")"
    [[ -n "$pub" ]] || fatal "the partial identity disappeared before it could be repaired"
    if grep -qxF "$pub" "$recipients" 2>/dev/null; then
      echo "enrollment was already repaired concurrently: $name -> $pub"
      return 0
    fi
  elif [[ -n "$dup" ]]; then
    pub="$(identity_recipient "$dup")"
    if [[ -n "$pub" ]] && ! grep -qxF "$pub" "$recipients" 2>/dev/null; then
      name="$dup"
      repair=1
    else
      fatal "key $comment ($fp) was enrolled concurrently as $dup"
    fi
  fi

  if [[ "$repair" -eq 0 ]]; then
    pub="$(keygen_identity "$name" "$fp")" || exit 1
  fi
  mkdir -p "$(dirname "$recipients")"
  append_recipient "$pub"
  if [[ "$repair" -eq 1 ]]; then
    echo "repaired enrollment $name -> $pub"
  else
    echo "enrolled $name -> $pub"
  fi
  echo "recipient added to $recipients"
  echo "now re-encrypt once from any machine holding an enrolled key in its agent:"
  echo "  age-ssh-nt reencrypt"
}

# Decrypt "${2:-$out}" into "$1" with the first enrolled identity whose key is in the
# current SSH agent. age aborts on the first plugin identity whose key is not
# in the agent, so each identity must be tried on its own.
decrypt_to() {
  local dest="$1" source="${2:-$out}"
  for id in "$identities_dir"/*.identity; do
    if age -d -i "$id" -o "$dest" "$source" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

# Hand the decrypted temp file to passage without leaving it on disk, setting
# $identities_src to the path passage should read. See the header comment for
# why Linux and macOS/BSD take different routes. The global EXIT trap covers
# every exit path; on Linux this additionally
# drops the name, turning the trap into a no-op and making even SIGKILL clean.
setup_identities_src() {
  local tmp="$1"
  if [[ "$(uname -s)" == Linux ]]; then
    exec 3<"$tmp" # keep the inode alive through fd 3...
    rm -f "$tmp"  # ...then drop the name: no file exists, nothing to clean up
    identities_src=/dev/fd/3
  else
    identities_src="$tmp"
  fi
}

# Create the decrypted-identities temp file and ensure it is deleted on every
# exit path. passage_tmp is script-global on purpose - the EXIT trap fires
# after the command function has returned, when its locals no longer exist.
identities_tmp() {
  passage_tmp="$(mktemp "$tmpdir/passage-identities.XXXXXX")"
}

# Re-encrypt identities.age to every enrolled outer recipient. This is distinct
# from `passage reencrypt`, which must remain a pass-through store operation.
cmd_reencrypt() {
  status_hint_on_error=1
  acquire_mutation_lock
  [[ -f "$out" ]] || fatal_with_hint \
    "no identities file at $out" \
    "run age-ssh-nt bootstrap, or restore a valid backup before re-encrypting"
  local header_valid=0
  read -r header_valid _ _ < <(age_header "$out" | age_header_info)
  [[ "$header_valid" -eq 1 ]] || fatal_with_hint \
    "$out is incomplete or invalid - refusing to re-encrypt it" \
    "restore $rotation_backup or another valid backup"
  [[ -f "$recipients" ]] && [[ -s "$recipients" ]] \
    || fatal "no recipients in $recipients (enroll with: age-ssh-nt enroll)"
  prepare_encryption_recipients || exit 1
  identities_tmp
  decrypt_to "$passage_tmp" || fatal_with_hint \
    "no enrolled identity matches a key in the current SSH agent" \
    "run from a session where one of these keys is in the agent (e.g. the box itself)"
  # record the identities' own public key so status can check the store side
  # without needing the agent (also heals boxes that never bootstrapped here).
  # Must read the temp file before setup_identities_src unlinks it on Linux.
  local sp="" current_content=""
  current_content="$(<"$passage_tmp")"
  sp="$(age-keygen -y <"$passage_tmp" 2>/dev/null || true)"
  setup_identities_src "$passage_tmp"
  # write to a sibling temp, then atomically rename on success: a crash
  # mid-write leaves the previous identities.age intact and decryptable
  age -a -R "$encryption_recipients_tmp" -o "$out.tmp" "$identities_src"
  chmod 600 "$out.tmp"
  if ! verify_identities "$out.tmp" "$current_content"; then
    rm -f "$out.tmp"
    fatal_with_hint \
      "re-encrypted identities could not be verified with any key in the current SSH agent" \
      "keep at least one currently available enrolled recipient until the new file is verified"
  fi
  prepare_out_recipients_hash || {
    rm -f "$out.tmp"
    exit 1
  }
  local out_rollback="$out.rollback.$$"
  cp -p "$out" "$out_rollback" || {
    rm -f "$out.tmp"
    exit 1
  }
  if ! mv -f "$out.tmp" "$out"; then
    rm -f "$out_rollback"
    exit 1
  fi
  if ! commit_out_recipients_hash; then
    mv -f "$out_rollback" "$out"
    echo "error: could not install recipient hash - restored previous identities" >&2
    exit 1
  fi
  rm -f "$out_rollback"
  [[ -n "$sp" ]] && printf '%s\n' "$sp" >"$identities_dir/store_recipient"
  echo "re-encrypted -> $out ($(recipient_count) recipient(s))"
}

# Rotate only the inner Passage identity; authorized_recipients and plugin
# identities stay untouched. Keep old + new store access and the encrypted old
# identity until explicit finalization proves the new identity works.
cmd_rotate() {
  status_hint_on_error=1
  acquire_mutation_lock
  guard_interrupted_rotation
  [[ -f "$out" ]] || fatal "no bootstrap yet ($out missing) - run: age-ssh-nt bootstrap"
  if rotation_backup_exists; then
    fatal_with_hint "a previous rotation is still pending: $rotation_backup" \
      "finish it with: age-ssh-nt rotate finalize"
  fi
  identities_tmp
  decrypt_to "$passage_tmp" || fatal_with_hint \
    "no enrolled identity matches a key in the current SSH agent" \
    "run from a session where one of these keys is in the agent (e.g. the box itself)"
  # Note: $passage_tmp keeps its named path (identities_tmp's
  # setup_identities_src is NOT called) because it feeds `passage reencrypt`
  # below; the EXIT trap removes it.
  local content="" store_pub="" old_store_pub="" rotation_note="" old_note=""
  old_store_pub="$(age-keygen -y <"$passage_tmp" 2>/dev/null || true)"
  [[ -n "$old_store_pub" ]] || fatal "could not derive the current identity's public key"
  content="$(age-keygen)"
  store_pub="$(printf '%s\n' "$content" | age-keygen -y 2>/dev/null || true)"
  [[ -n "$store_pub" ]] || fatal "could not derive the fresh identity's public key"
  local store_files=() failed_files=() n_store_files=0 verified_files=0 old_recipient_missing=0 passage_dir="$PASSAGE_DIR"
  [[ -d "$passage_dir" ]] && passage_dir="$(cd -P -- "$passage_dir" && pwd)"
  mapfile -t store_files < <(find "$passage_dir" -name '*.age' -type f 2>/dev/null || true)
  n_store_files=${#store_files[@]}
  grep -qxF "$old_store_pub" "$store_recipients" 2>/dev/null || old_recipient_missing=1

  # manifest: what will happen, before anything is changed
  echo
  echo "rotating will:" >&2
  {
    printf 'what\tpath\tdetail\n'
    printf 'backup\t%s\told encrypted identity (keep until the store is verified)\n' "$rotation_backup"
    printf 'rewrite\t%s\tfresh identity (same %s enrolled recipient(s))\n' "$out" "$(recipient_count)"
    if [[ "$old_recipient_missing" -eq 1 ]]; then
      printf 'repair\t%s\trestore the missing old recipient, then add the new identity\n' "$store_recipients"
    else
      printf 'update\t%s\tadd the new identity; retain the old recipient as a rotation backup\n' "$store_recipients"
    fi
    if [[ "$n_store_files" -gt 0 ]]; then
      printf 'reencrypt\t%s\t%s store file(s) to old + new identities\n' "$PASSAGE_DIR" "$n_store_files"
    else
      printf 'skip\t%s\tno store files to re-encrypt\n' "$PASSAGE_DIR"
    fi
  } | manifest_table
  echo "  (the SSH side - authorized_recipients, *.identity files - is untouched)" >&2

  local ans="" verify_ans=""
  if [[ "$n_store_files" -gt 0 ]]; then
    if read -r -p "verify current store files before rotating? [Y/n] " verify_ans; then
      case "${verify_ans,,}" in
      "" | y | yes)
        verify_store_files "$passage_tmp"
        echo "verified current store: $verified_files/$n_store_files file(s) decrypt" >&2
        if [[ ${#failed_files[@]} -gt 0 ]]; then
          echo "warning: the current identity could not decrypt:" >&2
          printf '  %s\n' "${failed_files[@]}" >&2
          echo "hint: inspect these entries with age-ssh-nt passage before rotating" >&2
          echo "      rotation may still proceed; the encrypted rotation backup remains for recovery" >&2
        fi
        ;;
      n | no)
        echo "current store verification skipped" >&2
        ;;
      *)
        echo "current store verification skipped (unrecognized answer: $verify_ans)" >&2
        ;;
      esac
    else
      echo "current store verification skipped (no input)" >&2
    fi
  fi

  if ! read -r -p "rotate the passage identities? [Y/n] " ans; then
    abort_command "rotate requires explicit confirmation"
  fi
  case "${ans,,}" in
  "" | y | yes) ;;
  *)
    abort_command "nothing was changed"
    ;;
  esac

  # Prepare and verify the new encrypted identity before changing the store.
  prepare_encryption_recipients || exit 1
  printf '%s\n' "$content" | age -a -R "$encryption_recipients_tmp" -o "$out.tmp"
  chmod 600 "$out.tmp"
  if ! verify_identities "$out.tmp" "$content"; then
    echo "error: decryption check failed - nothing was changed" >&2
    rm -f "$out.tmp"
    exit 1
  fi
  prepare_out_recipients_hash || {
    rm -f "$out.tmp"
    exit 1
  }
  begin_store_recipients_snapshot || {
    rm -f "$out.tmp"
    exit 1
  }

  # Re-encrypt once to old + new. The old recipient and encrypted identities
  # remain available as an explicit recovery path for any file passage skips.
  if [[ "$old_recipient_missing" -eq 1 ]]; then
    old_note="# age-ssh-nt: restored current identity recipient before rotation"
    store_recipients_ensure "$old_store_pub" "$old_note" || {
      rm -f "$out.tmp"
      exit 1
    }
    if [[ "$store_recipients_result" == "added" ]]; then
      echo "restored old store recipient: $store_recipients" >&2
    fi
  fi
  rotation_note="# age-ssh-nt: rotation pending - backup recipient: $old_store_pub
# keep it and $rotation_backup until every store entry works with the new identity"
  store_recipients_ensure "$store_pub" "$rotation_note" || {
    rm -f "$out.tmp"
    exit 1
  }
  if [[ "$store_recipients_result" == "added" ]]; then
    echo "store recipients updated: $store_recipients" >&2
  else
    echo "store recipients already up to date: $store_recipients" >&2
  fi
  if ! grep -qxF "$old_store_pub" "$store_recipients" 2>/dev/null \
    || ! grep -qxF "$store_pub" "$store_recipients" 2>/dev/null; then
    rm -f "$out.tmp"
    echo "error: could not ensure both old and new store recipients - nothing was rotated" >&2
    exit 1
  fi
  if [[ "$n_store_files" -gt 0 ]]; then
    echo "re-encrypting the store to the current recipients (old + new identity)..." >&2
    if ! PASSAGE_DIR="$passage_dir" PASSAGE_IDENTITIES_FILE="$passage_tmp" passage reencrypt; then
      rm -f "$out.tmp"
      echo "error: passage re-encryption failed - the old identity remains active" >&2
      exit 1
    fi
  fi

  # Preserve the old encrypted identities, then install the already-verified
  # new file. If the second rename fails, restore the old file immediately.
  mv "$out" "$rotation_backup"
  if ! mv -f "$out.tmp" "$out"; then
    mv -f "$rotation_backup" "$out"
    echo "error: could not install the new identities - restored the old file" >&2
    exit 1
  fi
  if ! commit_out_recipients_hash; then
    mv -f "$rotation_backup" "$out"
    echo "error: could not install recipient hash - restored the old identities" >&2
    exit 1
  fi
  rotation_installed=1
  printf '%s\n' "$store_pub" >"$identities_dir/store_recipient"
  commit_store_recipients_snapshot
  echo "verified - rotated -> $out" >&2
  echo "rotation backup kept: $rotation_backup" >&2
  echo "cleanup: age-ssh-nt rotate finalize" >&2
}

# Finalization derives the old recipient from the encrypted backup, which is
# authoritative even if marker comments were edited. Remove that backup only
# after every store file verifies with the current identity.
cmd_rotate_finalize() {
  status_hint_on_error=1
  acquire_mutation_lock
  guard_interrupted_rotation
  plain_file "$out" || fatal "current identities is not a regular file: $out"
  plain_file "$rotation_backup" || fatal "no regular rotation backup to finalize: $rotation_backup"

  identities_tmp
  rotation_tmp="$(mktemp "$tmpdir/passage-identities-backup.XXXXXX")"
  if ! decrypt_to "$passage_tmp" "$out"; then
    echo "error: could not decrypt the current identities" >&2
    exit 1
  fi
  if ! decrypt_to "$rotation_tmp" "$rotation_backup"; then
    echo "error: could not decrypt the rotation backup" >&2
    exit 1
  fi

  local store_pub="" old_store_pub="" passage_dir="$PASSAGE_DIR" ans=""
  local store_files=() failed_files=() verified_files=0
  store_pub="$(age-keygen -y <"$passage_tmp" 2>/dev/null || true)"
  old_store_pub="$(age-keygen -y <"$rotation_tmp" 2>/dev/null || true)"
  rm -f "$rotation_tmp"
  rotation_tmp=""
  [[ -n "$store_pub" ]] && [[ -n "$old_store_pub" ]] \
    || fatal "could not derive the current and backup store recipients"
  [[ "$store_pub" != "$old_store_pub" ]] \
    || fatal "current identities and rotation backup contain the same identity"
  plain_file "$store_recipients" || fatal "store recipients is not a regular file: $store_recipients"
  grep -qxF "$store_pub" "$store_recipients" \
    || fatal "current identity is missing from $store_recipients"

  [[ -d "$passage_dir" ]] && passage_dir="$(cd -P -- "$passage_dir" && pwd)"
  mapfile -t store_files < <(find -H "$passage_dir" -name '*.age' -type f 2>/dev/null || true)
  verify_store_files "$passage_tmp"
  if [[ ${#failed_files[@]} -gt 0 ]]; then
    echo "error: refusing to remove the rotation backup; the current identity could not decrypt:" >&2
    printf '  %s\n' "${failed_files[@]}" >&2
    exit 1
  fi

  echo >&2
  echo "finalizing rotation will:" >&2
  {
    printf 'what\tpath\tdetail\n'
    printf 'verify\t%s\t%s store file(s) decrypt with the current identity\n' "$PASSAGE_DIR" "${#store_files[@]}"
    printf 'update\t%s\tremove the old recipient and managed rotation note\n' "$store_recipients"
    if [[ ${#store_files[@]} -gt 0 ]]; then
      printf 'reencrypt\t%s\tremove old recipient stanzas\n' "$PASSAGE_DIR"
    fi
    printf 'remove\t%s\tencrypted old identity\n' "$rotation_backup"
  } | manifest_table
  if ! read -r -p "finalize this rotation? [y/N] " ans; then
    abort_command "nothing was changed"
  fi
  case "${ans,,}" in
  y | yes) ;;
  *)
    abort_command "nothing was changed"
    ;;
  esac

  begin_store_recipients_snapshot
  store_recipients_remove_rotation "$old_store_pub" "$store_pub"
  grep -qxF "$store_pub" "$store_recipients" \
    || fatal "current identity disappeared while removing the old recipient"
  if [[ ${#store_files[@]} -gt 0 ]]; then
    echo "re-encrypting the store to the current recipients..." >&2
    if ! PASSAGE_DIR="$passage_dir" PASSAGE_IDENTITIES_FILE="$passage_tmp" passage reencrypt; then
      echo "error: passage re-encryption failed - rotation backup retained" >&2
      exit 1
    fi
    verify_store_files "$passage_tmp"
    if [[ ${#failed_files[@]} -gt 0 ]]; then
      echo "error: post-cleanup verification failed - rotation backup retained" >&2
      printf '  %s\n' "${failed_files[@]}" >&2
      exit 1
    fi
  fi
  commit_store_recipients_snapshot
  rm -f "$rotation_backup"
  echo "verified - rotation finalized; backup removed: $rotation_backup" >&2
}

# Pass arguments through to Passage unchanged, including `reencrypt`. The
# decrypted temp path is script-global because the EXIT trap owns its cleanup
# after this function's locals are gone.
cmd_passage() {
  status_hint_on_error=1
  passage_tmp=""
  local idents=("$identities_dir"/*.identity) passage_dir="$PASSAGE_DIR"
  case "${1:-}" in
  init | insert | add | edit | generate | delete | rm | remove | rename | mv | copy | cp | reencrypt | git)
    acquire_mutation_lock
    ;;
  esac
  [[ -e "${idents[0]}" ]] || fatal "no age identities in $identities_dir (enroll with: age-ssh-nt enroll)"
  identities_tmp
  decrypt_to "$passage_tmp" || fatal_with_hint \
    "could not decrypt $out" \
    "one of the enrolled keys must be in the SSH agent (ssh-add it, or connect with ssh -A)"
  setup_identities_src "$passage_tmp"
  [[ -d "$passage_dir" ]] && passage_dir="$(cd -P -- "$passage_dir" && pwd)"
  echo "passage via age-ssh-nt: $*" >&2
  suppress_status_hint
  PASSAGE_DIR="$passage_dir" PASSAGE_IDENTITIES_FILE="$identities_src" passage "$@"
}

# Status is strictly read-only. It uses the recorded exact hash for outer
# recipients; store ciphertext exposes only stanza counts, so combine those
# counts with real identity and store decryption probes when the agent permits.
cmd_status() {
  local rows=() pending=() n_rec=0 raw_rec=0 n_enc=0 n_store=0 raw_store=0 store_duplicates=0
  local id name f stanzas stale=0 invalid=0 incomparable=0 expected_store=0
  local header_valid=0 header_comparable=0
  local store_files=() probe_content="" probe_id="" store_pub="" ref_pub=""
  local current_hash="" recorded_hash="" matching_agent=0 store_recipients_ok=0 store_backup_ok=0
  agent_has_enrolled_key && matching_agent=1

  # ---- age-ssh-nt side ----
  if [[ -f "$out" ]]; then
    n_rec="$(recipient_count)"
    raw_rec="$(raw_recipient_count)"
    if [[ "$raw_rec" -gt "$n_rec" ]]; then
      rows+=("recipients config" "$recipients" "$((raw_rec - n_rec)) duplicate key line(s) ignored for encryption")
      pending_add "remove duplicate key lines from $recipients"
    fi
    if [[ "$n_rec" -eq 0 ]]; then
      rows+=("state" "$AGE_SSH_NT_HOME" "bootstrapped but no enrolled recipients (run: age-ssh-nt enroll)")
      pending_add "age-ssh-nt enroll"
    else
      read -r header_valid n_enc header_comparable < <(age_header "$out" | age_header_info)
      if [[ "$header_valid" -ne 1 ]]; then
        rows+=("state" "$AGE_SSH_NT_HOME" "identities.age invalid or truncated")
        pending_add "restore a valid identities backup or diagnose $out"
      else
        current_hash="$(recipient_set_hash "$recipients" 2>/dev/null || true)"
        recorded_hash="$(cat "$out_recipients_hash" 2>/dev/null || true)"
        if [[ -z "$recorded_hash" ]]; then
          rows+=("state" "$AGE_SSH_NT_HOME" "identities.age recipient set unverified (run: age-ssh-nt reencrypt)")
          pending_add "age-ssh-nt reencrypt"
        elif [[ "$recorded_hash" != "$current_hash" ]]; then
          rows+=("state" "$AGE_SSH_NT_HOME" "identities.age stale: authorized recipient set changed")
          pending_add "age-ssh-nt reencrypt"
        elif [[ "$header_comparable" -eq 1 ]] && [[ "$n_enc" -ne "$n_rec" ]]; then
          rows+=("state" "$AGE_SSH_NT_HOME" "identities.age stale: encrypted to $n_enc of $n_rec recipient(s)")
          pending_add "age-ssh-nt reencrypt"
        elif [[ "$header_comparable" -eq 0 ]]; then
          rows+=("state" "$AGE_SSH_NT_HOME" "identities.age recipient set fresh ($n_rec recipient(s), exact hash; custom stanza count varies)")
        else
          rows+=("state" "$AGE_SSH_NT_HOME" "identities.age recipient set fresh ($n_rec recipient(s), exact set)")
        fi
      fi
    fi
    for f in "$identities_dir"/*.identity; do
      [[ -f "$f" ]] || continue
      line="$(sed -n 's/^# ssh key: //p' "$f" | head -1)"
      rows+=("key" "$(basename "$f" .identity)" "${line:-enrolled}")
    done
    # decrypt the identities into memory (never a file) with the first enrolled
    # identity whose key is in the agent; age aborts on the first plugin
    # identity whose key is not in the agent, so each must be tried on its own
    probe_content=""
    probe_id=""
    for f in "$identities_dir"/*.identity; do
      [[ -f "$f" ]] || continue
      if probe_content="$(age -d -i "$f" "$out" 2>/dev/null)"; then
        probe_id="$(basename "$f" .identity)"
        break
      fi
    done
    if [[ -n "$probe_id" ]]; then
      rows+=("agent" "${SSH_AUTH_SOCK:-unset}" "can decrypt now: yes (via $probe_id)")
      rows+=("ciphertext" "$out" "cryptographically valid")
      store_pub="$(printf '%s\n' "$probe_content" | age-keygen -y 2>/dev/null || true)"
    elif [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
      rows+=("agent" "unset" "can decrypt now: no - no SSH agent in this session (SSH_AUTH_SOCK unset)")
    elif [[ ! -S "$SSH_AUTH_SOCK" ]]; then
      rows+=("agent" "$SSH_AUTH_SOCK" "can decrypt now: no - SSH_AUTH_SOCK points at a socket that is gone")
    elif [[ "$matching_agent" -eq 1 ]]; then
      rows+=("agent" "$SSH_AUTH_SOCK" "can decrypt now: no - enrolled key is present but decryption failed")
      rows+=("ciphertext" "$out" "invalid or plugin decryption failed")
      pending_add "restore a valid identities backup or diagnose plugin decryption for $out"
    else
      rows+=("agent" "$SSH_AUTH_SOCK" "can decrypt now: no - no enrolled key in the current SSH agent")
    fi
  else
    rows+=("state" "$AGE_SSH_NT_HOME" "not bootstrapped (run: age-ssh-nt bootstrap)")
    pending_add "age-ssh-nt bootstrap"
  fi
  if rotation_backup_exists; then
    if [[ ! -f "$rotation_backup" ]] || [[ -L "$rotation_backup" ]]; then
      rows+=("rotation backup" "$rotation_backup" "invalid backup object - blocks rotation")
      pending_add "inspect or remove invalid backup object: $rotation_backup"
    elif [[ -f "$out" ]]; then
      rows+=("rotation backup" "$rotation_backup" "pending cleanup - keep until every store entry works with the new identity")
      pending_add "age-ssh-nt rotate finalize (verify every store entry; remove the marked backup recipient)"
    else
      rows+=("rotation backup" "$rotation_backup" "interrupted rotation - restore this file as $out")
      pending_add "restore $rotation_backup as $out"
    fi
  fi
  if path_exists "$store_recipients_snapshot"; then
    if [[ ! -f "$store_recipients_snapshot" ]] || [[ -L "$store_recipients_snapshot" ]]; then
      rows+=("rotation recipients" "$store_recipients_snapshot" "invalid snapshot object")
      pending_add "inspect invalid recipient snapshot: $store_recipients_snapshot"
    elif rotation_backup_exists && [[ -f "$out" ]]; then
      rows+=("rotation recipients" "$store_recipients_snapshot" "leftover snapshot after identity installation")
      pending_add "verify rotation state, then remove $store_recipients_snapshot"
    else
      rows+=("rotation recipients" "$store_recipients_snapshot" "interrupted before identity installation - original recipients preserved here")
      pending_add "restore $store_recipients_snapshot as $store_recipients"
    fi
  elif [[ -f "$store_recipients" ]] \
    && grep -q '^# age-ssh-nt: rotation pending - backup recipient:' "$store_recipients" \
    && ! rotation_backup_exists; then
    rows+=("rotation recipients" "$store_recipients" "rotation marker without an identity backup - inspect orphan recipients")
    pending_add "inspect orphan rotation recipients in $store_recipients"
  fi

  # ---- passage side ----
  if [[ -d "$PASSAGE_DIR" ]]; then
    mapfile -t store_files < <(find -H "$PASSAGE_DIR" -name '*.age' -type f 2>/dev/null || true)
    rows+=("store" "$PASSAGE_DIR" "${#store_files[@]} store file(s)")
  else
    rows+=("store" "$PASSAGE_DIR" "no passage store found")
  fi
  if path_exists "$store_recipients_backup"; then
    if valid_store_recipients_file "$store_recipients_backup"; then
      store_backup_ok=1
      rows+=("recipients backup" "$store_recipients_backup" "optional recovery copy - safe to delete after validating current recipients")
    elif plain_file "$store_recipients_backup"; then
      rows+=("recipients backup" "$store_recipients_backup" "invalid recipient file")
      pending_add "remove invalid backup or let the next recipient rewrite replace $store_recipients_backup"
    else
      rows+=("recipients backup" "$store_recipients_backup" "invalid backup object - mutations are blocked")
      pending_add "inspect or remove invalid backup object: $store_recipients_backup"
    fi
  fi
  if path_exists "$store_recipients"; then
    if valid_store_recipients_file "$store_recipients"; then
      store_recipients_ok=1
    else
      rows+=("recipients" "$store_recipients" "invalid or unsafe recipient file")
      if [[ "$store_backup_ok" -eq 1 ]]; then
        pending_add "restore $store_recipients_backup as $store_recipients"
      else
        pending_add "inspect or restore $store_recipients"
      fi
    fi
  fi
  if [[ "$store_recipients_ok" -eq 1 ]]; then
    n_store="$(recipient_count "$store_recipients")"
    raw_store="$(raw_recipient_count "$store_recipients")"
    store_duplicates=$((raw_store - n_store))
    expected_store="$raw_store"
    local ent="entries"
    [[ "$n_store" -eq 1 ]] && ent="entry"
    if [[ "$store_duplicates" -gt 0 ]]; then
      rows+=("recipients config" "$store_recipients" "$store_duplicates duplicate key line(s) make Passage write duplicate stanzas")
      pending_add "remove duplicate key lines from $store_recipients"
    fi
    # Real key-line check: the identity's actual age1... key (derived from the
    # decrypted identities when the agent is present, otherwise read from the
    # store_recipient sidecar that bootstrap/reencrypt record) must be listed.
    ref_pub="${store_pub:-$(cat "$identities_dir/store_recipient" 2>/dev/null || true)}"
    if [[ -n "$ref_pub" ]]; then
      if grep -qxF "$ref_pub" "$store_recipients" 2>/dev/null; then
        rows+=("recipients" "$store_recipients" "$n_store $ent - new entries encrypt to the age-ssh-nt identity: yes")
      else
        rows+=("recipients" "$store_recipients" "$n_store $ent - age-ssh-nt identity not listed (new entries won't be decryptable)")
        pending_add "add the identities' key to $store_recipients, then: age-ssh-nt passage reencrypt"
      fi
    else
      rows+=("recipients" "$store_recipients" "$n_store $ent - identity presence unknown (no recorded store recipient; run: age-ssh-nt reencrypt)")
    fi
    if [[ -d "$PASSAGE_DIR" ]] && [[ "$n_store" -gt 0 ]]; then
      stale=0
      invalid=0
      incomparable=0
      for f in "${store_files[@]}"; do
        read -r header_valid stanzas header_comparable < <(age_header "$f" | age_header_info)
        if [[ "$header_valid" -ne 1 ]]; then
          invalid=1
          break
        elif [[ "$header_comparable" -eq 0 ]]; then
          incomparable=1
        elif [[ "$stanzas" -ne "$expected_store" ]]; then
          stale=1
        fi
      done
      if [[ "$invalid" -eq 1 ]]; then
        rows+=("store files" "$PASSAGE_DIR" "invalid - at least one .age header is malformed, truncated, or not recipient-managed")
        pending_add "inspect or restore invalid .age files in $PASSAGE_DIR"
      elif [[ "$stale" -eq 1 ]]; then
        if [[ "$store_duplicates" -gt 0 ]]; then
          rows+=("store files" "$PASSAGE_DIR" "recipient config has duplicates - remove them before re-encrypting")
        else
          rows+=("store files" "$PASSAGE_DIR" "stale - re-encrypt to the current $n_store $ent (run: age-ssh-nt passage reencrypt)")
          pending_add "age-ssh-nt passage reencrypt"
        fi
      elif [[ "$incomparable" -eq 1 ]]; then
        rows+=("store files" "$PASSAGE_DIR" "closed recipient headers; custom stanza counts are not comparable to recipient lines")
      else
        if [[ "$store_duplicates" -gt 0 ]]; then
          rows+=("store files" "$PASSAGE_DIR" "matches $raw_store configured recipient lines ($n_store unique); remove duplicates, then re-encrypt")
        else
          rows+=("store files" "$PASSAGE_DIR" "up to date ($n_store $ent)")
        fi
      fi
    fi
    # Definitive check: decrypt every store file with the identities themselves.
    # The recipient list could be edited without re-encrypting (or coincidentally
    # match in count), so only an actual decryption proves readability. The
    # identities travel via stdin (age -d -i -), never a file.
    if [[ ${#store_files[@]} -gt 0 ]]; then
      if [[ -n "$probe_id" ]]; then
        invalid=0
        for f in "${store_files[@]}"; do
          printf '%s\n' "$probe_content" | age -d -i - -o /dev/null "$f" 2>/dev/null \
            || invalid=$((invalid + 1))
        done
        if [[ "$invalid" -eq 0 ]]; then
          rows+=("store readable" "$PASSAGE_DIR" "yes - decrypts with the age-ssh-nt identity now")
        else
          rows+=("store readable" "$PASSAGE_DIR" "no - $invalid/${#store_files[@]} file(s) do not decrypt with the age-ssh-nt identity")
          pending_add "age-ssh-nt passage reencrypt"
        fi
      else
        rows+=("store readable" "$PASSAGE_DIR" "cannot verify without an enrolled key in the current SSH agent")
      fi
    fi
  elif [[ ! -e "$store_recipients" ]] && [[ ! -L "$store_recipients" ]]; then
    rows+=("recipients" "$store_recipients" "missing (no store initialized here)")
    if [[ "$store_backup_ok" -eq 1 ]]; then
      pending_add "restore $store_recipients_backup as $store_recipients"
    fi
  fi

  {
    printf 'what\tpath\tdetail\n'
    printf '%s\t%s\t%s\n' "${rows[@]}"
  } | manifest_table
  echo >&2
  if [[ ${#pending[@]} -gt 0 ]]; then
    echo "pending:" >&2
    for p in "${pending[@]}"; do
      echo "  - $p" >&2
    done
  else
    echo "all set - nothing pending" >&2
  fi
}

# Open the documentation: glow when available, else less, else cat.
cmd_doc() {
  [[ -f "$doc" ]] || fatal_with_hint "documentation not found: $doc" \
    "set AGE_SSH_NT_DOC to the markdown file's path"
  if command -v glow >/dev/null 2>&1; then
    glow -p "$doc"
  elif command -v less >/dev/null 2>&1; then
    less "$doc"
  else
    cat "$doc"
  fi
}

case "${1:-}" in
"")
  usage
  exit 0
  ;;
help | -h | --help)
  help_command="$1"
  shift
  require_no_args "$help_command" "$@"
  usage
  exit 0
  ;;
bootstrap)
  shift
  require_no_args bootstrap "$@"
  cmd_bootstrap
  ;;
enroll)
  shift
  cmd_enroll "$@"
  ;;
reencrypt)
  shift
  require_no_args reencrypt "$@"
  cmd_reencrypt
  ;;
rotate)
  shift
  case "${1:-}" in
  "") cmd_rotate ;;
  finalize)
    shift
    require_no_args "rotate finalize" "$@"
    cmd_rotate_finalize
    ;;
  *)
    echo "error: rotate takes no arguments unless finalizing (use: age-ssh-nt rotate finalize)" >&2
    usage
    exit 1
    ;;
  esac
  ;;
status)
  shift
  require_no_args status "$@"
  cmd_status
  ;;
passage)
  shift
  cmd_passage "$@"
  ;;
doc)
  shift
  require_no_args doc "$@"
  cmd_doc
  ;;
*)
  echo "error: unknown subcommand: ${1:-}" >&2
  usage
  exit 1
  ;;
esac
