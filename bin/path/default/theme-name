#!/usr/bin/env bash

# like the old `current-base16` but backed by tinty: prints the bare scheme
# name (e.g. solarized-light) for consumers that need the tone
# ("One tone, every layer" - ../../docs/philosophy.md)
#
# asks `tinty current` (tinty's own API) rather than reading its internal
# state file - consumers must not know the layout, the same principle as
# the stable `~/.active-theme` link. solarized-dark fallback keeps consumers
# sane before the first apply ever runs (fresh installs) or on setups
# without tinty (containers/throwaways).

out="$(tinty current 2>/dev/null)" || out=""
test -z "$out" && {
  printf '%s' solarized-dark
  exit
}

# strip the family prefix (base16-, base24-, ...) leaving the bare scheme
# name - `${out#*-}` cuts up to the first dash, which is exactly the family
# prefix in tinty scheme names, so switching theme families (e.g.
# base16-solarized-light -> base24-builtin-solarized-light) needs no edit
# here (the pair itself is bridged by ../../bin/path/default/theme-pair -
# the only interface to it, owning the file paths)
printf '%s' "${out#*-}"
